[
  {
    "id": "recruiter",
    "label": "Recruiter",
    "when": [
      { "key": "referrer",   "op": "contains", "value": "linkedin" },
      { "key": "searchTerm", "op": "contains", "value": "hire" }
    ],
    "matchAny": true,
    "then": {
      "sectionOrder": ["hero","work","about","insights","record","training","harvics","intelligence","contact"],
      "heroCta": "See the work",
      "heroCtaHref": "#work"
    }
  },
  {
    "id": "conference",
    "label": "Conference Organizer",
    "when": [
      { "key": "searchTerm",   "op": "contains", "value": "speaker" },
      { "key": "searchTerm",   "op": "contains", "value": "keynote" },
      { "key": "dwellSection", "op": "equals",   "value": "record" }
    ],
    "matchAny": true,
    "then": {
      "sectionOrder": ["hero","record","about","work","insights","training","harvics","intelligence","contact"],
      "heroCta": "View addresses",
      "heroCtaHref": "#record"
    }
  },
  {
    "id": "corporate",
    "label": "Corporate Client",
    "when": [
      { "key": "dwellSection", "op": "equals",   "value": "training" },
      { "key": "searchTerm",   "op": "contains", "value": "advisory" },
      { "key": "searchTerm",   "op": "contains", "value": "training" }
    ],
    "matchAny": true,
    "then": {
      "sectionOrder": ["hero","training","work","about","insights","record","harvics","intelligence","contact"],
      "heroCta": "Discuss a program",
      "heroCtaHref": "#training"
    }
  },
  {
    "id": "default",
    "label": "General Visitor",
    "when": [],
    "matchAny": false,
    "then": {
      "sectionOrder": ["hero","about","work","insights","record","training","harvics","intelligence","contact"],
      "heroCta": "See the work",
      "heroCtaHref": "#work"
    }
  }
]
